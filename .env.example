# Copy to .env and fill in.  `cp .env.example .env`
# .env is gitignored — it is the only place secrets belong. Never put a real
# value in .env.example, .claude/settings.json, or any committed file.
#
# SCOPE: repo-wide values only — things used across the whole monorepo, not by
# one component. Component env belongs with its component:
#   infrastructure/  — docker-compose, DB creds, per-service vars  (devops owns it)
#   backend/         — its own env, defined when the component is built
#   frontend/        — same
# If a variable is only meaningful to one package, it does not go in this file.

# ---------------------------------------------------------------------------
# Notifications — Telegram
# ---------------------------------------------------------------------------
# Read by .claude/hooks/notify.sh. Pings you when Claude needs input, and at the
# two human gates in /feature and /fix (tests to verify, PR to approve).
# Leave both blank to disable — the desktop notification still works without them.
#
#   TELEGRAM_BOT_TOKEN — message @BotFather -> /newbot
#   TELEGRAM_CHAT_ID   — message your new bot once, then open
#                        https://api.telegram.org/bot<TOKEN>/getUpdates
#                        and read result[0].message.chat.id
#
# Verify before trusting it in a real run:
#   NOTIFY_DEBUG=1 .claude/hooks/notify.sh "test"
# A wrong token otherwise fails silently, exactly like "not configured".
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Set to 1 to print the Telegram API reply instead of swallowing it.
# Leave empty in normal use.
NOTIFY_DEBUG=

# Set to 1 to print what WOULD be sent and send nothing — no banner, no
# Telegram message. Use it when changing notify.sh so testing the script
# doesn't spam you. Leave empty in normal use.
NOTIFY_DRY_RUN=
